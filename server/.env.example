# Copy this file to .env and fill in your own values.

# --- Required -------------------------------------------------
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/launchkit
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# --- Google sign-in --------------------------------------------
# Must not be empty or the server won't start. Placeholders are fine if you
# don't need Google sign-in; the "Google" button just won't work.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# --- Store settings (optional; defaults shown) -----------------
# TAX_RATE=0.08              # 8% tax added at checkout
# PLATFORM_FEE_RATE=0.1      # 10% kept by the platform from each sale
# EARNINGS_HOLD_DAYS=7       # days before a sale's earnings can be withdrawn
# MIN_PAYOUT_CENTS=1000      # smallest payout a seller can request ($10.00)
# PAYMENT_PROVIDER=sandbox   # test-mode gateway; no real charges
